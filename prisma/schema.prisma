generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── CMS ─────────────────────────────────────────────────────────

enum CmsRole {
  SUPER_ADMIN
  EDITOR
  REVIEWER
}

// Tipo principal del usuario — define a qué sistemas tiene acceso
enum UserKind {
  ADMIN          // Administrador único — acceso total a CMS y webapp
  CMS_EDITOR     // Editor del CMS — solo acceso a /cms (crea y edita páginas)
  CMS_REVIEWER   // Revisor del CMS — solo /cms (lectura, aprueba)
  PRODUCER       // Productor — solo webapp, gestiona proyectos y equipo
  TEAM           // Equipo audiovisual — solo webapp, ve proyectos asignados
  CLIENT         // Cliente — solo webapp, ve y aprueba sus proyectos
}

enum PageStatus {
  DRAFT
  REVIEW
  PUBLISHED
}

enum AssetSource {
  UPLOAD     // Archivo subido a nuestro storage (Vercel Blob o local)
  URL        // URL externa pegada (Vimeo, Drive público, S3 cliente, etc.)
}

enum EmbedKind {
  NONE                 // No es embed (PDF, otro tipo)
  IMAGE                // Imagen estándar
  DRIVE_FILE           // Archivo individual de Google Drive (video por preview)
  DRIVE_FOLDER_PHOTOS  // Carpeta de Drive con fotos (visor con multi-select)
  DRIVE_FOLDER_VIDEOS  // Carpeta de Drive con videos (lista de players)
  DRIVE_FOLDER_MIXED   // Carpeta de Drive mixta
  VIMEO                // Video de Vimeo
  YOUTUBE              // Video de YouTube
  DIRECT_VIDEO         // .mp4 directo
  EXTERNAL_LINK        // URL externa genérica
}

// ─── Webapp de proyectos ─────────────────────────────────────────

enum OrgType {
  CLIENT       // empresa que paga (PepsiCo, etc.)
  PRODUCER     // productora externa o aliada
  INTERNAL     // tu propia casa (Labstream)
}

enum OrgRole {
  OWNER        // puede aprobar / decidir
  MEMBER       // puede comentar / ver
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectRole {
  EXEC_PRODUCER
  PRODUCER
  DIRECTOR
  DOP
  CAMERA
  PHOTOGRAPHER
  EDITOR
  COLORIST
  SOUND
  VFX
  AI_ARTIST
  ART_DIRECTOR
  PRODUCTION_ASSISTANT
  CLIENT_LEAD          // cliente con poder de aprobar
  CLIENT_VIEWER        // cliente solo observa
  OTHER
}

enum PhaseType {
  BRIEF
  PROPOSAL
  PRE
  PRODUCTION
  POST
  DELIVERY
  CUSTOM
}

enum PhaseStatus {
  PENDING
  ACTIVE
  COMPLETED
  ON_HOLD
}

enum TaskStatus {
  TODO
  DOING
  REVIEW
  DONE
  BLOCKED
}

enum DeliverableKind {
  TREATMENT
  SCRIPT
  STORYBOARD
  CASTING
  LOCATION
  PPM
  ROUGH_CUT
  FINE_CUT
  PICTURE_LOCK
  COLOR
  SOUND_MIX
  MASTER
  PHOTOSET
  STREAM_RECORDING
  OTHER
}

enum DeliverableStatus {
  DRAFT             // productor armando
  INTERNAL_REVIEW   // pendiente pre-aprobación interna
  CLIENT_REVIEW     // ya enviado al cliente
  CHANGES_REQUESTED
  APPROVED
}

enum ApprovalStage {
  INTERNAL          // productor / equipo pre-aprueba
  CLIENT            // cliente da OK final
}

enum ApprovalDecision {
  APPROVED
  CHANGES_REQUESTED
}

// ─── User (extiende del CMS) ─────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String
  role          CmsRole   @default(EDITOR)
  kind          UserKind  @default(TEAM)
  active        Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String?
  createdBy     User?     @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers  User[]    @relation("UserCreatedBy")

  // CMS relations
  pageAssignments  PageAssignment[]
  pagesUpdated     Page[]    @relation("PageUpdatedBy")
  blocksUpdated    Block[]   @relation("BlockUpdatedBy")
  assetsUploaded   Asset[]
  sessions         Session[]

  // Webapp relations
  orgMemberships     OrgMember[]
  projectMemberships ProjectMember[]
  projectsCreated    Project[]            @relation("ProjectCreatedBy")
  taskAssignments    TaskAssignee[]
  versionsSubmitted  DeliverableVersion[]
  approvalsGiven     Approval[]
  commentsAuthored   Comment[]
  commentsResolved   Comment[]            @relation("CommentResolver")
  reviewLinksCreated ReviewLink[]         @relation("ReviewLinkCreator")
  activityActor      ActivityLog[]        @relation("ActivityActor")

  @@index([email])
  @@index([role])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── CMS models (sin cambios) ────────────────────────────────────

model Page {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  description String?
  status      PageStatus @default(DRAFT)
  isHome      Boolean    @default(false)
  order       Int        @default(0)
  metaTitle   String?
  metaDesc    String?
  ogImageId   String?
  ogImage     Asset?     @relation("PageOgImage", fields: [ogImageId], references: [id])
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  updatedById String?
  updatedBy   User?      @relation("PageUpdatedBy", fields: [updatedById], references: [id])

  blocks      Block[]
  assignments PageAssignment[]

  @@index([slug])
  @@index([status])
}

model PageAssignment {
  id        String   @id @default(cuid())
  pageId    String
  userId    String
  canEdit   Boolean  @default(true)
  createdAt DateTime @default(now())
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pageId, userId])
  @@index([userId])
}

model Block {
  id          String   @id @default(cuid())
  pageId      String
  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type        String
  order       Int      @default(0)
  data        Json
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("BlockUpdatedBy", fields: [updatedById], references: [id])

  @@index([pageId, order])
}

model Asset {
  id          String      @id @default(cuid())
  source      AssetSource
  filename    String?
  mimeType    String?
  sizeBytes   Int?
  url         String              // URL pública final (Blob, local /uploads, o external)
  thumbnailUrl String?            // URL de thumbnail si aplica (Drive, Vimeo, etc.)
  alt         String?
  caption     String?
  width       Int?
  height      Int?
  storage     String   @default("local")  // "blob" | "local" | "external"
  blobPath    String?            // path en Vercel Blob para poder borrar después
  uploadedById String?
  uploadedBy   User?      @relation(fields: [uploadedById], references: [id])
  createdAt   DateTime    @default(now())

  pageOgImages       Page[]               @relation("PageOgImage")
  servicesCover      Service[]            @relation("ServiceCover")
  versionsAttached   DeliverableVersion[]
  commentFrames      Comment[]            @relation("CommentFrame")

  @@index([source])
  @@index([uploadedById])
  @@index([createdAt])
}

model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String?
  content     String?
  // Detalle de servicio para la página /servicio/[slug]
  longDescription String?  // markdown / texto largo
  heroImageUrl    String?
  capabilities    Json?    // [{ icon, title, desc }, ...]
  process         Json?    // [{ step, title, desc }, ...]
  pricing         String?  // "Desde $X" o texto libre
  order       Int      @default(0)
  visible     Boolean  @default(true)
  coverId     String?
  cover       Asset?   @relation("ServiceCover", fields: [coverId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([visible, order])
}

model MenuItem {
  id        String   @id @default(cuid())
  label     String
  href      String
  location  String   @default("header")
  order     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([location, order])
}

model SiteSettings {
  id           String   @id @default("singleton")
  siteName     String   @default("Labstream Studio")
  tagline      String?
  logoUrl      String?
  faviconUrl   String?
  contactEmail String?
  socials      Json?

  // Theming
  fontHeading  String   @default("Instrument Serif")
  fontBody     String   @default("Figtree")
  colorPrimary String   @default("#E8640C")
  colorAccent  String   @default("#7B61FF")
  colorBg      String   @default("#080808")
  colorText    String   @default("#F0F0EE")

  updatedAt    DateTime @updatedAt
}

// ─── Webapp: Organizations ───────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  type      OrgType
  logoUrl   String?
  website   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members          OrgMember[]
  clientProjects   Project[]   @relation("ClientOrg")
  producerProjects Project[]   @relation("ProducerOrg")

  @@index([type])
  @@index([name])
}

model OrgMember {
  id        String   @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgRole   OrgRole  @default(MEMBER)
  title     String?  // ej "Brand Manager", "Productora ejecutiva"
  createdAt DateTime @default(now())

  @@unique([orgId, userId])
  @@index([userId])
}

// ─── Webapp: Projects ────────────────────────────────────────────

model Project {
  id            String        @id @default(cuid())
  code          String        @unique         // ej PEPSI-2026-AGRO
  name          String
  description   String?
  status        ProjectStatus @default(DRAFT)
  startDate     DateTime?
  dueDate       DateTime?
  budget        Decimal?

  clientOrgId   String
  clientOrg     Organization @relation("ClientOrg", fields: [clientOrgId], references: [id])
  producerOrgId String
  producerOrg   Organization @relation("ProducerOrg", fields: [producerOrgId], references: [id])

  templateId    String?
  template      ProjectTemplate? @relation(fields: [templateId], references: [id])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String?
  createdBy     User?     @relation("ProjectCreatedBy", fields: [createdById], references: [id])

  members       ProjectMember[]
  phases        Phase[]
  deliverables  Deliverable[]
  activity      ActivityLog[]

  @@index([clientOrgId])
  @@index([producerOrgId])
  @@index([status])
}

model ProjectMember {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectRole  ProjectRole
  createdAt    DateTime @default(now())

  @@unique([projectId, userId, projectRole])
  @@index([userId])
}

// ─── Templates ───────────────────────────────────────────────────

model ProjectTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  phases    TemplatePhase[]
  projects  Project[]
}

model TemplatePhase {
  id          String   @id @default(cuid())
  templateId  String
  template    ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  type        PhaseType
  name        String
  order       Int

  tasks  TemplateTask[]

  @@index([templateId, order])
}

model TemplateTask {
  id        String   @id @default(cuid())
  phaseId   String
  phase     TemplatePhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  title     String
  defaultRole ProjectRole?
  order     Int

  @@index([phaseId, order])
}

// ─── Phases & Tasks ──────────────────────────────────────────────

model Phase {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      PhaseType
  name      String
  order     Int
  status    PhaseStatus @default(PENDING)
  startDate DateTime?
  dueDate   DateTime?

  tasks         Task[]
  deliverables  Deliverable[]

  @@index([projectId, order])
}

model Task {
  id        String     @id @default(cuid())
  phaseId   String
  phase     Phase      @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  title     String
  description String?
  status    TaskStatus @default(TODO)
  order     Int        @default(0)
  dueDate   DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  assignees TaskAssignee[]

  @@index([phaseId, order])
  @@index([phaseId, status])
}

model TaskAssignee {
  id      String  @id @default(cuid())
  taskId  String
  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
}

// ─── Deliverables (versionados) ──────────────────────────────────

model Deliverable {
  id            String            @id @default(cuid())
  projectId     String
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseId       String?
  phase         Phase?            @relation(fields: [phaseId], references: [id])
  kind          DeliverableKind
  title         String
  description   String?
  status        DeliverableStatus @default(DRAFT)

  currentVersionId String?       @unique
  currentVersion   DeliverableVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id])

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  versions  DeliverableVersion[] @relation("DeliverableVersions")
  approvals Approval[]

  @@index([projectId])
  @@index([status])
}

model DeliverableVersion {
  id            String   @id @default(cuid())
  deliverableId String
  deliverable   Deliverable @relation("DeliverableVersions", fields: [deliverableId], references: [id], onDelete: Cascade)
  versionNumber Int

  // Una de tres: link externo, archivo subido (asset), o snapshot Drive
  externalUrl   String?
  assetId       String?
  asset         Asset?   @relation(fields: [assetId], references: [id])

  // Detección de tipo de embed para renderizar el visor correcto
  embedKind     EmbedKind @default(NONE)

  // Para Drive — extraídos del externalUrl (carpeta o file individual)
  driveFolderId String?
  driveFileId   String?

  // Snapshot de la última lectura de la carpeta Drive (para detectar cambios)
  driveLastCheckedAt DateTime?
  driveFileCount     Int?
  driveSnapshotJson  Json?     // [{ id, name, mimeType, modifiedTime }, ...]

  notes         String?  // qué cambió en esta versión
  submittedById String
  submittedBy   User     @relation(fields: [submittedById], references: [id])
  submittedAt   DateTime @default(now())

  isCurrent  Deliverable? @relation("CurrentVersion")
  comments   Comment[]
  approvals  Approval[]
  reviewLinks ReviewLink[]

  @@unique([deliverableId, versionNumber])
  @@index([driveFolderId])
}

model Approval {
  id            String           @id @default(cuid())
  deliverableId String
  deliverable   Deliverable      @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  versionId     String
  version       DeliverableVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  stage         ApprovalStage
  decision      ApprovalDecision
  comment       String?
  decidedById   String
  decidedBy     User             @relation(fields: [decidedById], references: [id])
  decidedAt     DateTime         @default(now())

  @@index([deliverableId])
  @@index([versionId])
}

model Comment {
  id            String   @id @default(cuid())
  versionId     String
  version       DeliverableVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  // Autor: o usuario logueado (authorId) o invitado (guestName + guestEmail)
  authorId      String?
  author        User?    @relation(fields: [authorId], references: [id])
  guestName     String?
  guestEmail    String?

  body          String   @db.Text
  timecodeSeconds Int?   // legacy — mantener compatibilidad
  videoTimeMs   Int?     // tiempo en ms en el video (preciso por frame)

  // Captura de frame opcional + dibujo encima
  frameAssetId  String?
  frameAsset    Asset?   @relation("CommentFrame", fields: [frameAssetId], references: [id])
  annotationsJson Json?  // [{ kind, color, ...coords }] coords normalizadas 0-1

  // Threading: respuestas de equipo / cliente al comentario raíz
  parentId      String?
  parent        Comment? @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Comment[] @relation("CommentThread")

  // Estado
  resolved      Boolean   @default(false)
  resolvedAt    DateTime?
  resolvedById  String?
  resolvedBy    User?     @relation("CommentResolver", fields: [resolvedById], references: [id])

  // Origen — útil para auditoría (review-link, app-interna, etc.)
  reviewLinkId  String?
  reviewLink    ReviewLink? @relation(fields: [reviewLinkId], references: [id], onDelete: SetNull)

  createdAt     DateTime @default(now())

  @@index([versionId, createdAt])
  @@index([parentId])
  @@index([resolved])
}

// ─── Review Links — links públicos compartibles para revisar entregables ──

model ReviewLink {
  id                   String   @id @default(cuid())
  slug                 String   @unique          // token unguessable, usado en /review/[slug]
  deliverableVersionId String
  version              DeliverableVersion @relation(fields: [deliverableVersionId], references: [id], onDelete: Cascade)

  title                String?                   // título opcional para el cliente
  message              String?  @db.Text         // mensaje de bienvenida del productor

  allowGuests          Boolean  @default(true)
  allowDrawings        Boolean  @default(true)
  allowDownload        Boolean  @default(false)
  requireGuestEmail    Boolean  @default(true)

  expiresAt            DateTime?
  revokedAt            DateTime?

  createdById          String
  createdBy            User     @relation("ReviewLinkCreator", fields: [createdById], references: [id])
  createdAt            DateTime @default(now())

  comments             Comment[]
  visits               ReviewVisit[]

  @@index([slug])
  @@index([deliverableVersionId])
}

model ReviewVisit {
  id           String   @id @default(cuid())
  reviewLinkId String
  reviewLink   ReviewLink @relation(fields: [reviewLinkId], references: [id], onDelete: Cascade)
  guestName    String?
  guestEmail   String?
  userId       String?  // si entró logueado
  userAgent    String?
  visitedAt    DateTime @default(now())

  @@index([reviewLinkId, visitedAt])
}

// ─── Audit / Activity ────────────────────────────────────────────

model ActivityLog {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation("ActivityActor", fields: [actorId], references: [id])
  type      String   // PROJECT_CREATED | MEMBER_ADDED | DELIVERABLE_SUBMITTED | APPROVED | …
  summary   String   // human readable
  payload   Json?
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

// ─── Contenido público (portafolio, blog, testimonios, etc.) ─────

enum PortfolioCategory {
  COMERCIAL
  DOCUMENTAL
  FOTOGRAFIA
  STREAMING
  BRANDED_CONTENT
  REDES_SOCIALES
  POST_PRODUCCION
  IA
  OTRO
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
}

model PortfolioProject {
  id            String            @id @default(cuid())
  slug          String            @unique
  title         String
  client        String?           // PepsiCo, Bavaria, etc.
  category      PortfolioCategory @default(COMERCIAL)
  year          Int
  excerpt       String?           // 1-2 líneas para card
  brief         String?           // qué pidió el cliente
  process       String?           // cómo lo abordamos (multi-paragraph)
  result        String?           // resultado / impacto
  coverImageUrl String?           // imagen de la card y hero
  videoUrl      String?           // video final (Vimeo, YouTube, Drive)
  galleryImages Json?             // [{ url, alt, caption }, ...]
  beforeAfter   Json?             // [{ before, after, label }, ...]
  credits       Json?             // [{ role, name }, ...]
  tags          String[]          @default([])
  featured      Boolean           @default(false)
  order         Int               @default(0)
  publishedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([category])
  @@index([year])
  @@index([featured])
}

model BlogPost {
  id            String         @id @default(cuid())
  slug          String         @unique
  title         String
  excerpt       String?
  content       String         // markdown / rich text
  coverImageUrl String?
  authorName    String?        // string libre por ahora
  authorRole    String?
  category      String?        // "Producción", "IA", "Industria", etc.
  tags          String[]       @default([])
  status        BlogPostStatus @default(DRAFT)
  readMinutes   Int?
  publishedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status])
  @@index([publishedAt])
  @@index([category])
}

model Testimonial {
  id          String   @id @default(cuid())
  authorName  String
  authorRole  String?  // "Brand Manager", "CMO", etc.
  authorCompany String?
  authorAvatarUrl String?
  body        String
  rating      Int?     // 1-5
  visible     Boolean  @default(true)
  featured    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([visible, order])
}

model ClientLogo {
  id          String   @id @default(cuid())
  name        String   // "PepsiCo"
  logoUrl     String   // SVG/PNG transparente
  websiteUrl  String?
  visible     Boolean  @default(true)
  featured    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([visible, order])
}

model FaqItem {
  id          String   @id @default(cuid())
  question    String
  answer      String
  category    String?  // "Servicios", "Pago", "Proceso", etc.
  visible     Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([visible, order])
}

model TeamMember {
  id          String   @id @default(cuid())
  name        String
  role        String   // "Director", "Productora ejecutiva"
  bio         String?
  photoUrl    String?
  instagram   String?
  vimeo       String?
  linkedin    String?
  visible     Boolean  @default(true)
  featured    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([visible, order])
}

model NewsletterSignup {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  source    String?  // "footer", "popup", "blog"
  createdAt DateTime @default(now())
}

model AboutContent {
  // Singleton — contenido de la página /nosotros
  id            String   @id @default("singleton")
  heroEyebrow   String?
  heroTitle     String?
  heroSubtitle  String?
  story         String?  // multi-paragraph
  mission       String?
  vision        String?
  values        Json?    // [{ icon, title, desc }, ...]
  updatedAt     DateTime @updatedAt
}

enum LeadStatus {
  NEW
  CONTACTED
  WON
  LOST
  SPAM
}

model Lead {
  id          String     @id @default(cuid())
  name        String
  email       String
  message     String     @db.Text
  source      String?    // "contact-form" | "newsletter-modal" | etc
  metadata    Json?      // empresa, teléfono, servicio, presupuesto, cronograma
  status      LeadStatus @default(NEW)
  notes       String?    @db.Text  // notas internas del equipo
  contactedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, createdAt])
  @@index([email])
}
