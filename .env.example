DATABASE_URL="postgresql://USER@localhost:5432/labstream_dev?schema=public"

AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST=true
NEXTAUTH_URL="http://localhost:3000"

# Storage local (dev) — fallback si BLOB_READ_WRITE_TOKEN no existe
UPLOADS_DIR="./public/uploads"
PUBLIC_UPLOADS_PATH="/uploads"
MAX_UPLOAD_MB=50

# Vercel Blob (storage persistente) — opcional
# Setup: Vercel → Storage → Create Blob → copia el token
BLOB_READ_WRITE_TOKEN=""

# Google Drive API — opcional, activa visor avanzado de carpetas
# Setup: ver docs/SETUP-CREDENTIALS.md
GOOGLE_DRIVE_API_KEY=""
GOOGLE_SERVICE_ACCOUNT_JSON=""

# Email — backend principal: SMTP (Synology o cualquier mail server)
# Si SMTP_HOST está set, se usa SMTP. Si falla, cae a Resend (si está configurado).
SMTP_HOST=""                              # ej. nas.labstreamsas.com
SMTP_PORT="587"                           # 587 (STARTTLS) o 465 (SSL)
SMTP_SECURE="false"                       # "true" para 465, "false" para 587
SMTP_USER=""                              # ej. labstream@labstreamsas.com
SMTP_PASS=""                              # contraseña del buzón
SMTP_TLS_REJECT_UNAUTHORIZED="true"       # ponlo en "false" si el cert del NAS es self-signed

# Email — backend de fallback: Resend (https://resend.com)
RESEND_API_KEY=""

# Remitente y destino
EMAIL_FROM="Labstream Studio <labstream@labstreamsas.com>"
CONTACT_EMAIL_TO="labstream@labstreamsas.com"
